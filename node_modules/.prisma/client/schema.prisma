generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String   @db.VarChar(255)
  email    String   @unique
  password String
  address  String   @db.Text
  profile  Profile? @relation
  posts    Post[]
  roles    String[] @default(["user"])
}

model Profile {
  id     Int    @id @default(autoincrement())
  userId Int    @unique
  bio    String @db.Text
  avatar String @db.VarChar(255)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Xóa profile khi user bị xóa
}

model Post {
  id      Int    @id @default(autoincrement())
  title   String @db.VarChar(255)
  content String @db.Text
  userId  Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Xóa bài viết khi user bị xóa
}
