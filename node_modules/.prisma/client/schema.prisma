generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String   @db.VarChar(255) // VARCHAR cho name
  email    String   @unique
  password String
  address  String   @db.Text // Text cho address
  profile  Profile? @relation // Quan hệ với Profile, không cần `onDelete: Cascade` ở đây
  posts    Post[] // Liên kết với bài viết, xóa bài viết khi User bị xóa
  roles    String[] @default(["user"]) // Lưu roles dưới dạng mảng
}

model Profile {
  id     Int    @id @default(autoincrement())
  userId Int    @unique
  bio    String @db.Text // Text cho bio
  avatar String @db.VarChar(255) // VARCHAR cho avatar
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Xóa profile khi user bị xóa
}

model Post {
  id      Int    @id @default(autoincrement())
  title   String @db.VarChar(255) // VARCHAR cho title
  content String @db.Text // Text cho nội dung bài viết
  userId  Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Xóa bài viết khi user bị xóa
}
